      },
      {
        "id": "c_hub_domain",
        "name": "hub-domain",
        "icon": "ic-diamond",
        "description": "Pure models, fixtures, invariants — no GPUI dep. Canonical V1: evals, blind A/B, labels"
      },
      {
        "id": "c_hub_projection",
        "name": "hub-projection",
        "icon": "ic-switch-module",
        "description": "Fail-closed command/read boundary: eval API first, matrix-os legacy overlay; live-API error → unavailable"
      },
      {
        "id": "c_hub_edge",
        "name": "hub-edge",
        "icon": "ic-router",
        "description": "iroh endhost: ALPNs hubcc/1, matrix-cs/1, bvvnc/1 + docs/gossip; allowlist fail-closed"
      },
      {
        "id": "c_iroh_relay",
        "name": "iroh relay",
        "icon": "ic-cloud"
      },
      {
        "id": "c_matrix_os_api",
        "name": "matrix-os API",
        "icon": "ic-server",
        "description": "Legacy quarantine — compatibility source only, never new-system protocol truth"
      },
      {
        "id": "c_matrix_homeserver",
        "name": "Matrix homeserver",
        "icon": "ic-mailmultiple"
      },
      {
        "id": "c_mlflow",
        "name": "MLflow",
        "icon": "ic-storage",
        "description": "Observed eval workbench — downstream projection/inspection, not activation authority"
      }
