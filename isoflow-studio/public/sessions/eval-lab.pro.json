}},{"id":"s2vvpeifib6due7bw9nbyl21","ref":{"item":"v2-promo"}}]},{"id":"d8h7lzx5y7aj9efh2j4upj12","anchors":[{"id":"xi9h1q8t6xjdorrecmwl6ncq","ref":{"item":"v2-promo"}},{"id":"ca4qceya666e04d122fnhmcp","ref":{"item":"v2-postgres"}}]},{"id":"wucsgy9s7ye47z5lnddoze44","anchors":[{"id":"l7bbh655feznnqx1ognouv0z","ref":{"item":"v2-adminapi"}},{"id":"qfdgrlipergyvdjwrl4rzmhg","ref":{"item":"v2-runner"}}]},{"id":"qvyn1hv48wl0ll3lfcqzm0hy","anchors":[{"id":"sy3m7eotw8pwcwi2mzb44ar4","ref":{"item":"v2-runner"}},{"id":"oinwmtkeo0vuocmoenn2yfhr","ref":{"item":"v2-pfcli"}}]},{"id":"xjtavgslmc6umgrj24bgpudv","anchors":[{"id":"mkmrcyg4qb1678zqqtuaivqk","ref":{"item":"v2-sharedlib"}},{"id":"s0r66c6yu56qj2zay11s4th7","ref":{"item":"v2-pfcli"}}]},{"id":"fntsd1iy54f7pz59rk6wylb4","anchors":[{"id":"l5je5y2da0iv0c4nvt2npwuv","ref":{"item":"v2-sharedlib"}},{"id":"zvfriip2r7w8568par1fyr28","ref":{"item":"v2-gates"}}]}],"textBoxes":[{"id":"tb2-pipeline","tile":{"x":-1,"y":1},"content":"Цільовий конвеєр: generator + gates + routing у прод → далі вже робоча черга ✅"},{"id":"tb2-sot","tile":{"x":-1,"y":5},"content":"Writers: promotion (evidence + human approval); revision_brief — вирішити долю"},{"id":"tb2-pf","tile":{"x":-1,"y":9},"content":"Promptfoo — canonical runner; евристики з єдиного ядра"}]}],"colors":[{"id":"blue","value":"#a5b8f3"},{"id":"purple","value":"#bbadfb"},{"id":"yellow","value":"#f4eb8e"},{"id":"orange","value":"#f0aca9"},{"id":"peach","value":"#fad6ac"},{"id":"green","value":"#a8dc9d"},{"id":"turquoise","value":"#b3e5e3"}],"flows":[]},"documents":{"list":[{"id":"doc-delta","itemReference":{"id":"doc-delta","type":"project.document"},"title":"Дельта 2026-07-13: що закрито, що лишилось","data":{"type":"doc","content":[{"type":"heading","attrs":{"level":1},"content":[{"text":"Eval Lab — ревізія 2026-07-13 (проти діаграми від 2026-07-10)","type":"text"}]},{"type":"paragraph","content":[{"text":"Верифіковано по коду matrix-os/auto_recruit + hub/. Ключові комmiti: «Hub operator release backplane» (8670fd11, 11.07) і hub-subtree merge з Command Center UI (12.07). Легенда: ✅ — закрито після попередньої ревізії; 🔴 — досі відкрито; 🟡 — працює з ризиком.","type":"text"}]},{"type":"paragraph"},{"type":"heading","attrs":{"level":2},"content":[{"text":"1) As-is сьогодні","type":"text"}]},{"type":"itemReference","attrs":{"refId":"v1-asis","itemRefType":"physicalTopology.view"}},{"type":"paragraph"},{"type":"heading","attrs":{"level":2},"content":[{"text":"✅ Закрито після 2026-07-10","type":"text"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Серверні кохорти (був «council scheduler not yet wired»). ","type":"text","marks":[{"type":"bold"}]},{"text":"Міграція 043: assignments як server-owned anti-anchoring контракт. claim_eval_label_assignments; _assignment_capture_mode (storage.py:804) — стабільний бакет blind / independent_first; двофазний флоу independent_first (незалежний вердикт → reveal панелі → фіналізація); snapshot shown_panel_score_id; supersession. POST лейблів вимагає assignment_id (eval_lab.py:103-107) — кохорту, panel snapshot і lineage виводить сервер.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Hub Eval Lab UI (були лише мокапи). ","type":"text","marks":[{"type":"bold"}]},{"text":"EvalLabThinLabelQueue.tsx — операторська черга: GET /internal/eval-lab/review-items, POST labels по assignment; council-докази рендеряться тільки після серверного reveal (інваріанти в evalLab.ts:216-219). EvalLabAdmin.tsx — overview / calibration / seed-families. Змонтовано в CommandCenterHome (admin-дефолт eval-lab, cmd+4), окрема admin-збірка IS_EVAL_LAB_ADMIN_BUILD.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Понад план: seed families / revisions. ","type":"text","marks":[{"type":"bold"}]},{"text":"Append-only lineage ревізій seed-паків (draft → active → retired), admin-ендпоїнти create/activate, outputs прив'язані до seed_revision. Плюс корекції лейблів: edit_text / corrected_output_payload / supersedes.","type":"text"}]}]}]},{"type":"paragraph"},{"type":"heading","attrs":{"level":2},"content":[{"text":"🔴 Досі відкрито (4 пункти — вони ж to-be)","type":"text"}]},{"type":"orderedList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"generator.py мертвий. ","type":"text","marks":[{"type":"bold"}]},{"text":"generate_foundation_pack_cases викликають лише tests/test_eval_lab.py; кандидати заходять тільки через promptfoo-імпорт.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"scoring.py + route_eval_candidate не в проді. ","type":"text","marks":[{"type":"bold"}]},{"text":"promptfoo_runner.py:1283-1284 створює лише RoutingDecision.WEAK_NEGATIVE. Нюанс: INSERT у eval_candidate_routes (storage.py:1350) вже не фільтрує за decision — труба готова, немає продюсера send_to_human / audit_sample.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Єдине ядро евристик не зроблено. ","type":"text","marks":[{"type":"bold"}]},{"text":"graders/anti_slop.py:18 досі «Keep this list aligned with auto_recruit/eval_lab/anti_slop_ru.py» — ручна копія, ризик дрейфу.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Writers відсутні. ","type":"text","marks":[{"type":"bold"}]},{"text":"build_promotion_evidence_for_runs явно «never writes an eval_promotion_decisions row»; при цьому admin_storage.py:798 вже ЧИТАЄ latest_decisions — read-плейн чекає на writer. eval_revision_briefs теж без INSERT; revision_brief.py осиротілий — кандидат на списання, бо seed revisions перекривають призначення.","type":"text"}]}]}]},{"type":"paragraph"},{"type":"heading","attrs":{"level":2},"content":[{"text":"Незмінне за дизайном (не гепи)","type":"text"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Фіче-флаги off за замовчуванням: AUTO_RECRUIT_EVAL_PROMPTFOO_ENABLED, …_LOCAL_RUN_ALLOWED, …_LANGFUSE_ENABLED.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Harvest-шляхи (Work Review / contact review) лишаються capture_mode=none — кохорти живуть у черзі assignments.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"«Council» = judge-панель promptfoo (eval_llm_panel_scores); якщо panel scores порожні — admin віддає eval.council_scores_missing. Окремого джерела council-сигналу немає, і це поки що осмислений компроміс.","type":"text"}]}]}]},{"type":"paragraph"},{"type":"heading","attrs":{"level":2},"content":[{"text":"2) To-be — залишок","type":"text"}]},{"type":"itemReference","attrs":{"refId":"v2-tobe","itemRefType":"physicalTopology.view"}},{"type":"paragraph","content":[{"text":"Порядок закриття природний: (1) generator + gates + routing у прод — вмикає весь лівий фланг; (2) єдине ядро евристик — прибирає дрейф graders; (3) promotion writer поверх готового read-плейну; (4) рішення по revision_brief.py — writer або деліт.","type":"text"}]}]}}]}}