item":"d_mailsvc"}},{"id":"fj6a51d4ky7dzw8ye710hptt","ref":{"item":"d_postgres"}}]}],"textBoxes":[{"id":"ti_prod","tile":{"x":-1,"y":13},"content":"PROD CORE","orientation":"Y"},{"id":"ti_3p","tile":{"x":13,"y":13},"content":"UNTRUSTED 3P (sees content)","orientation":"Y"}]}],"colors":[{"id":"blue","value":"#a5b8f3"},{"id":"purple","value":"#bbadfb"},{"id":"yellow","value":"#f4eb8e"},{"id":"orange","value":"#f0aca9"},{"id":"peach","value":"#fad6ac"},{"id":"green","value":"#a8dc9d"},{"id":"turquoise","value":"#b3e5e3"}],"flows":[]},"documents":{"list":[{"id":"doc_ideal","itemReference":{"id":"doc_ideal","type":"project.document"},"title":"Ideal setup — spec & recommendations","data":{"type":"doc","content":[{"type":"heading","attrs":{"level":1},"content":[{"text":"AutoRecruit — Ideal setup","type":"text"}]},{"type":"paragraph","content":[{"text":"Five trust contours, cold to hot. iroh + Headscale is the management spine; target egress is always the RU proxy; every required third party is assume-compromised (sees content, never your origin).","type":"text"}]},{"type":"itemReference","attrs":{"refId":"vi_contours","itemRefType":"physicalTopology.view"}},{"type":"itemReference","attrs":{"refId":"vi_fleet","itemRefType":"physicalTopology.view"}},{"type":"itemReference","attrs":{"refId":"vi_issuers","itemRefType":"physicalTopology.view"}},{"type":"heading","attrs":{"level":2},"content":[{"text":"Contours (cold -> hot)","type":"text"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"OPERATOR (cold):","type":"text","marks":[{"type":"bold"}]},{"text":" any device, reaches Hub only via an IP-blind edge (Cloudflare Tunnel). No fixed home IP touches prod. Nice-to-have: FIDO2 hardware key, hardened browser profile.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"PROD CORE (warm, pet):","type":"text","marks":[{"type":"bold"}]},{"text":" prodbox = matrix-os, Postgres (state, source of truth), Matrix, Hermes x4, workers, Browser Viewer, Hub backend, MLflow, :8317 router. Long-lived, PITR backups, hardened (vault/SGX). Never touches target sites, never rotated.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"INFERENCE (elastic):","type":"text","marks":[{"type":"bold"}]},{"text":" :8317 is a sensitivity-aware router. Providers: RentGPU (live agentic, ephemeral rented GPU), macbox llama.cpp (eval-gen async via iroh-blobs; optional cheap local inference), cloud LLM (overflow). Route identity-bearing prompts to macbox-local or a secure-cloud GPU; bulk to cheapest.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"HANDS (hot, cattle):","type":"text","marks":[{"type":"bold"}]},{"text":" fleet of ephemeral browser runtimes, own netns, RU-proxy-only egress, reached only via iroh relay. Burn on leak; never co-located with prod core.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"UNTRUSTED 3P (assume compromised):","type":"text","marks":[{"type":"bold"}]},{"text":" RU proxy, mail/SMS/CAPTCHA providers, marketplaces. See content (inherent), never your origin (hidden). Per-account, burnable, no reuse.","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Hands substrate — recommendation (hybrid)","type":"text"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Buy 1-2 bare-metal boxes (Hetzner/OVH) -> run Proxmox you OWN (no provider sees your VM disk/traffic).","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"On it: CubeSandbox / Firecracker microVMs for ephemeral Hands (fast spawn, per-account, burn after); full VMs for persistent goldens (VulpineOS / QEMU-Android / Lume) you snapshot.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Keep exe.dev as burst/overflow + fallback while you build the substrate. Do not rip it out day one.","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Rotation — your cron idea, calibrated","type":"text"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Hands microVM: rotate per-account / per-session (cattle, cheap). Primary hygiene lever.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Substrate box: blue/green every 6-10 days (randomized) - provision new, join mesh, pass a coherence smoke test, drain, cut over, destroy old. Guards against provider profiling + management-plane IP hygiene. Good idea; automate it.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"RentGPU: ephemeral per-workload.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"NEVER rotate state-bearing nodes (Postgres, Matrix identities, Hermes personas) - it breaks continuity. Prod core = harden + back up, not rotate.","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"RentGPU — trust note","type":"text"}]},{"type":"paragraph","content":[{"text":"The GPU host operator can read VRAM (prompts + weights). Treat as content-exposed: route identity-bearing agentic prompts to macbox-local or a reputable secure-cloud GPU (e.g. RunPod Secure Cloud); send only generic/bulk to cheapest spot GPUs. Disk encryption helps little against a malicious host.","type":"text"}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Nice-to-haves","type":"text"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Dedicated tiny coordinator VPS for Headscale control + iroh relay, decoupled from the app core.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Self-host catch-all mail on your domain with a dedicated receiving IP + Nym on the receive path.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"iroh-blobs for all dataset/artifact movement (content-addressed, verified, resumable).","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Per-account everything (proxy, mailbox, number) - no reuse. Primary anti-correlation lever.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Secrets in a vault; Postgres PITR; coherence smoke-test gate before any new Hands host goes live.","type":"text"}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"text":"Open","type":"text"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Headscale control home: dedicated coordinator VPS (recommended) vs prodbox.","type":"text"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"text":"Which secure-cloud GPU provider for sensitive agentic inference.","type":"text"}]}]}]}]}},{"id":"b9596481-5bb9-45e3-bbdf-8fe87ea3c16a","itemReference":{"id":"c_operator","type":"physicalTopology.component"},"title":"physicalTopology.component-c_operator-description","data":{"type":"doc","content":[{"type":"paragraph"}]}}]}}